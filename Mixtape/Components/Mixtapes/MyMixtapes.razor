@* The mixtapes of who signed in, and the tile that starts a new one. *@
@inject CoverStore CoverStore

<h1 class="mx-heading">@L["Mine.Title"]</h1>

<ul class="mx-gallery">
    @foreach (ArtistInfo mixtape in Mixtapes)
    {
        <li>
            <a class="mx-gallery-item mx-artist-item" href="@PageNames.ArtistUrl(mixtape.Slug)">
                <div class="mx-cover" aria-hidden="true">@((MarkupString)CoverStore.GetCover(mixtape.CoverFileName, mixtape.Name))</div>
                <span class="mx-gallery-caption">
                    <b>@mixtape.Name</b>
                    <span>@L["Artist.Songs", mixtape.TrackCount]</span>
                </span>
            </a>
        </li>
    }

    <li>
        <a class="mx-gallery-item mx-new" href="@PageNames.NewMixtape">
            <div class="mx-cover" aria-hidden="true">+</div>
            <span class="mx-gallery-caption">
                <b>@L["Mine.New"]</b>
                <span>@L["Mine.Count", Mixtapes.Count, MixtapeLimits.MaxMixtapes]</span>
            </span>
        </a>
    </li>
</ul>

<p class="mx-more"><a class="mx-small" href="@PageNames.Examples">@L["Examples.Title"] →</a></p>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ArtistInfo> Mixtapes { get; set; } = null!;
}
