@attribute [Route(PageNames.Home)]
@inject IArtistsService ArtistsService
@inject CoverStore CoverStore

<PageTitle>Mixtape</PageTitle>

@if (artists.Count == 0)
{
    <RakoMessage Image="brand/rako-empty.svg" Title="@L["Home.EmptyTitle"]">
        <p>@L["Home.EmptyText"]</p>
    </RakoMessage>
}
else
{
    <h1 class="mx-heading">@L["Home.Title"]</h1>

    <ul class="mx-gallery">
        @foreach (ArtistInfo artist in artists)
        {
            <li>
                <a class="mx-gallery-item mx-artist-item" href="@PageNames.ArtistUrl(artist.Slug)">
                    <div class="mx-cover" aria-hidden="true">@((MarkupString)CoverStore.GetCover(artist.CoverFileName))</div>
                    <span class="mx-gallery-caption">
                        <b>@artist.Name</b>
                        <span>@L["Artist.Songs", artist.TrackCount]</span>
                    </span>
                </a>
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<ArtistInfo> artists = [];

    protected override async Task OnInitializedAsync()
    {
        artists = await ArtistsService.GetArtistsAsync();
    }
}
