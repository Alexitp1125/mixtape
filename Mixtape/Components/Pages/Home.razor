@attribute [Route(PageNames.Home)]
@inject IMixtapesService MixtapesService
@inject CoverStore CoverStore

<PageTitle>Mixtape</PageTitle>

@if (userKey is not null)
{
    @* With the session open: the mixtapes of the person and the tile to start a new one. *@
    <h1 class="mx-heading">@L["Mine.Title"]</h1>

    <ul class="mx-gallery">
        @foreach (ArtistInfo mixtape in mixtapes)
        {
            <li>
                <a class="mx-gallery-item mx-artist-item" href="@PageNames.ArtistUrl(mixtape.Slug)">
                    <div class="mx-cover" aria-hidden="true">@((MarkupString)CoverStore.GetCover(mixtape.CoverFileName, mixtape.Name))</div>
                    <span class="mx-gallery-caption">
                        <b>@mixtape.Name</b>
                        <span>@L["Artist.Songs", mixtape.TrackCount]</span>
                    </span>
                </a>
            </li>
        }

        <li>
            <a class="mx-gallery-item mx-new" href="@PageNames.NewMixtape">
                <div class="mx-cover" aria-hidden="true">+</div>
                <span class="mx-gallery-caption">
                    <b>@L["Mine.New"]</b>
                    <span>@L["Mine.Count", mixtapes.Count, MixtapeLimits.MaxMixtapes]</span>
                </span>
            </a>
        </li>
    </ul>

    <p class="mx-more"><a class="mx-small" href="@PageNames.Examples">@L["Examples.Title"] →</a></p>
}
else
{
    @* Welcome: what the app is, the two ways in and a few covers. *@
    <section class="mx-hero">
        <div>
            <h1>Mixtape</h1>
            <p>@L["Welcome.Tagline"]</p>

            <div class="mx-actions">
                <a class="mx-btn mx-btn-main" href="@PageNames.AccessUrl(create: true)">@L["Welcome.Create"]</a>
                <a class="mx-btn" href="@PageNames.AccessUrl(create: false)">@L["Layout.SignIn"]</a>
                <a class="mx-link" href="@PageNames.Examples">@L["Welcome.Example"] →</a>
            </div>
        </div>

        @* The three covers are a link to the example mixtapes. *@
        <a class="mx-hero-art" href="@PageNames.Examples" aria-label="@L["Welcome.Example"]">
            <div class="mx-cover">@((MarkupString)CoverStore.GetCover("doma.svg"))</div>
            <div class="mx-cover">@((MarkupString)CoverStore.GetCover("bugambilia.svg"))</div>
            <div class="mx-cover">@((MarkupString)CoverStore.GetCover("al-sudeste.svg"))</div>
        </a>
    </section>

    <ol class="mx-steps">
        <li><b>01</b><span>@L["Welcome.Step1"]</span></li>
        <li><b>02</b><span>@L["Welcome.Step2"]</span></li>
        <li><b>03</b><span>@L["Welcome.Step3"]</span></li>
    </ol>
}

@code {
    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    // Who signed in; null for a visitor.
    private Guid? userKey;

    private IReadOnlyList<ArtistInfo> mixtapes = [];

    protected override async Task OnInitializedAsync()
    {
        userKey = HttpContext.User.GetUserKey();

        if (userKey is not null)
        {
            mixtapes = await MixtapesService.GetMineAsync(userKey.Value);
        }
    }
}
