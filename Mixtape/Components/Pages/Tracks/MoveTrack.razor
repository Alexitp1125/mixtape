@attribute [Route(PageNames.MoveTrack)]
@inject ITracksService TracksService
@inject IArtistsService ArtistsService
@inject IMixtapesService MixtapesService
@inject NavigationManager Navigation

@if (track is not null && mixtape is not null)
{
    <PageTitle>@L["MoveTrack.Title", track.Title] · Mixtape</PageTitle>

    @* The form is a window over the mixtape the song is in. *@
    <div class="mx-modal">
        <form class="mx-form" method="post" @formname="move-track" @onsubmit="SubmitAsync">
            <AntiforgeryToken />

            <a class="mx-modal-close" href="@PageNames.ArtistUrl(mixtape.Slug)" aria-label="@L["Common.Close"]">✕</a>

            <h1 class="mx-form-title">@L["MoveTrack.Title", track.Title]</h1>

            @if (error is not null)
            {
                <p class="mx-error" role="alert">@error</p>
            }

            <fieldset class="mx-options">
                <legend>@L["MoveTrack.To"]</legend>

                @foreach (ArtistInfo other in others)
                {
                    <label>
                        <input type="radio" name="Target" value="@other.Slug" checked="@(other.Slug == SelectedTarget)" required />
                        @other.Name
                    </label>
                }

                <label>
                    <input type="radio" name="Target" value="@NewTarget" id="move-new" checked="@(SelectedTarget == NewTarget)" required />
                    @L["Mine.New"]
                </label>
            </fieldset>

            @* Only for a new mixtape: js/forms.js enables it when "New mixtape" is chosen. *@
            <label class="mx-field">
                <span>@L["MoveTrack.NewName"]</span>
                <input type="text" name="NewName" value="@NewName" maxlength="30" required disabled="@(SelectedTarget != NewTarget)" data-enable-with="move-new" />
            </label>

            <div class="mx-form-actions">
                <a class="mx-btn" href="@PageNames.ArtistUrl(mixtape.Slug)">@L["Common.Cancel"]</a>
                <button class="mx-btn mx-btn-main" type="submit">@L["MoveTrack.Submit"]</button>
            </div>
        </form>
    </div>

    @* Behind the window, the mixtape as it is now. It cannot be used while the window is open. *@
    <div inert aria-hidden="true">
        <MixtapeView Artist="mixtape" ShowLimit="true" EmptyText="@L["Mixtape.Empty"].Value" />
    </div>
}

@code {
    // Value of the choice "New mixtape". The addresses of real mixtapes always end in random letters.
    private const string NewTarget = "new";

    // Slug of the song that moves.
    [Parameter]
    public string Slug { get; set; } = null!;

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    // Slug of the mixtape that gets the song, or NewTarget.
    [SupplyParameterFromForm(FormName = "move-track")]
    private string? Target { get; set; }

    [SupplyParameterFromForm(FormName = "move-track")]
    private string? NewName { get; set; }

    private TrackDetails? track;

    // The mixtape the song is in: what shows behind the window.
    private ArtistDetails? mixtape;
    private Guid? userKey;
    private string? error;

    // The other mixtapes of the person.
    private IReadOnlyList<ArtistInfo> others = [];

    // What was chosen or, before choosing, the first of the other mixtapes (a new one when there are none).
    private string SelectedTarget => Target ?? others.FirstOrDefault()?.Slug ?? NewTarget;

    protected override async Task OnInitializedAsync()
    {
        userKey = HttpContext.User.GetUserKey();

        if (userKey is null)
        {
            Navigation.NotFound();
            return;
        }

        TrackDetails? found = await TracksService.GetTrackAsync(Slug);
        IReadOnlyList<ArtistInfo> mine = await MixtapesService.GetMineAsync(userKey.Value);

        // Only the owner of the mixtape the song is in can move it.
        if (found is null || !mine.Any(x => x.Slug == found.ArtistSlug))
        {
            Navigation.NotFound();
            return;
        }

        track = found;
        mixtape = await ArtistsService.GetArtistAsync(found.ArtistSlug);
        others = mine.Where(x => x.Slug != found.ArtistSlug).ToList();
    }

    // Moves the song and opens the mixtape that got it.
    private async Task SubmitAsync()
    {
        if (track is null || userKey is null)
        {
            return;
        }

        MixtapeResult result = await MixtapesService.MoveTrackAsync(
            userKey.Value,
            track.Slug,
            SelectedTarget == NewTarget ? null : SelectedTarget,
            NewName);

        if (result.Slug is null)
        {
            error = L[$"Mixtape.Error.{result.Status}", MixtapeLimits.MaxMixtapes, MixtapeLimits.MaxTracks].Value;
            return;
        }

        Navigation.NavigateTo(PageNames.ArtistUrl(result.Slug));
    }
}
