@attribute [Route(PageNames.Track)]
@inject TrackCatalog Catalog
@inject NavigationManager Navigation

@if (track is not null)
{
    <PageTitle>@track.Title · @track.Artist · Mixtape</PageTitle>

    <a class="mx-back" href="@PageNames.Home">← @L["Track.Back"]</a>

    @* The cover stays here (static) and only the player is interactive: the SVG never travels through the circuit. *@
    <div class="mx-stage">
        <div class="mx-record">
            <div class="mx-vinyl"></div>
            <div class="mx-cover" aria-hidden="true">@((MarkupString)cover)</div>
        </div>

        @* A new player for each song (@key), also when ⏮ ⏭ go from song to song. *@
        <SongPlayer @key="track.Slug" Track="track" PreviousUrl="@previousUrl" NextUrl="@nextUrl" @rendermode="InteractiveAuto" />

        @* Blurred copy of the cover behind the whole page. *@
        <div class="mx-ambient" aria-hidden="true">@((MarkupString)ambient)</div>
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = null!;

    private TrackDetails? track;
    private string cover = "";
    private string ambient = "";
    private string previousUrl = "";
    private string nextUrl = "";

    protected override void OnInitialized()
    {
        track = Catalog.GetTrack(Slug);

        if (track is null)
        {
            Navigation.NotFound();
            return;
        }

        cover = Catalog.GetCover(track.Slug);

        // Same cover with its own IDs, so the blurred copy doesn't reuse the animated masks and gradients.
        ambient = cover.Replace("id=\"", "id=\"amb-").Replace("url(#", "url(#amb-");

        previousUrl = PageNames.TrackUrl(Catalog.GetPrevious(track).Slug);
        nextUrl = PageNames.TrackUrl(Catalog.GetNext(track).Slug);
    }
}
