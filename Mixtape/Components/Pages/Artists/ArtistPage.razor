@attribute [Route(PageNames.Artist)]
@inject IArtistsService ArtistsService
@inject IMixtapesService MixtapesService
@inject NavigationManager Navigation

@if (artist is not null)
{
    <PageTitle>@artist.Name · Mixtape</PageTitle>

    <a class="mx-back" href="@BackUrl">← @BackText</a>

    @if (error is not null)
    {
        <p class="mx-error" role="alert">@error</p>
    }

    <MixtapeView Artist="artist" ShowLimit="isOwner" EmptyText="@(isOwner ? L["Mixtape.Empty"].Value : L["Home.EmptyText"].Value)">
        <OwnerTools>
            @* What the owner of a mixtape can do with it. Share is run by js/app-shell.js. *@
            @if (isOwner)
            {
                <div class="mx-owner">
                    @* A full mixtape says so in the place of the button. *@
                    @if (artist.Tracks.Count < MixtapeLimits.MaxTracks)
                    {
                        <a class="mx-btn mx-btn-main" href="@PageNames.AddTrackUrl(artist.Slug)">@L["Mixtape.AddTrack"]</a>
                    }
                    else
                    {
                        <span class="mx-btn mx-btn-off">@L["Mixtape.Full"]</span>
                    }
                    <button class="mx-btn" type="button" data-app-share data-copied="@L["Layout.LinkCopied"]">@L["Layout.Share"]</button>
                    <a class="mx-btn" href="@PageNames.EditMixtapeUrl(artist.Slug)">@L["Mixtape.Edit"]</a>
                    <button class="mx-btn mx-btn-danger" type="button" popovertarget="delete-mixtape">@L["Mixtape.Delete"]</button>
                </div>

                @* Deleting asks first, in a small window. *@
                <div class="mx-sheet" id="delete-mixtape" popover>
                    <h2>@L["Mixtape.DeleteTitle", artist.Name]</h2>
                    <p>@L["Mixtape.DeleteConfirm"]</p>

                    <form class="mx-form-actions" method="post" @formname="delete-mixtape" @onsubmit="DeleteAsync">
                        <AntiforgeryToken />
                        <button class="mx-btn" type="button" popovertarget="delete-mixtape" popovertargetaction="hide">@L["Common.Cancel"]</button>
                        <button class="mx-btn mx-btn-danger" type="submit">@L["Mixtape.DeleteYes"]</button>
                    </form>
                </div>

                @* The buttons of each song send this form: the name of the button says what to do and its value, which song. *@
                <form id="song-action" method="post" @formname="song-action" @onsubmit="SongActionAsync">
                    <AntiforgeryToken />
                </form>
            }
        </OwnerTools>

        <SongTools Context="track">
            @* The actions of a song, in a small window that the button on its cover opens. *@
            @if (isOwner)
            {
                <button class="mx-more-btn" type="button" popovertarget="@SheetId(track)" aria-label="@L["Mixtape.SongActions", track.Title]">⋯</button>

                <div class="mx-sheet" id="@SheetId(track)" popover>
                    <h2>@track.Title</h2>

                    <div class="mx-sheet-list">
                        <a href="@PageNames.EditTrackUrl(track.Slug)">@L["Mixtape.EditTrack"]</a>
                        <a href="@PageNames.MoveTrackUrl(track.Slug)">@L["Mixtape.Move"]</a>

                        @* The first song doesn't go up and the last one doesn't go down. *@
                        @if (track != artist.Tracks.First())
                        {
                            <button type="submit" form="song-action" name="UpSlug" value="@track.Slug">@L["Mixtape.Up"]</button>
                        }

                        @if (track != artist.Tracks.Last())
                        {
                            <button type="submit" form="song-action" name="DownSlug" value="@track.Slug">@L["Mixtape.Down"]</button>
                        }

                        @* Removing asks first: the line opens and shows the question. *@
                        <details class="mx-sheet-ask">
                            <summary class="mx-sheet-danger">@L["Mixtape.Remove"]</summary>
                            <p>@L["Mixtape.RemoveConfirm"]</p>

                            <div class="mx-form-actions">
                                <button class="mx-btn" type="button" popovertarget="@SheetId(track)" popovertargetaction="hide">@L["Common.Cancel"]</button>
                                <button class="mx-btn mx-btn-danger" type="submit" form="song-action" name="RemoveSlug" value="@track.Slug">@L["Mixtape.RemoveYes"]</button>
                            </div>
                        </details>
                    </div>
                </div>
            }
        </SongTools>
    </MixtapeView>
}

@code {
    [Parameter]
    public string Slug { get; set; } = null!;

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    // Slug of the song, in the button that was pressed: to move it up, to move it down or to remove it.
    [SupplyParameterFromForm(FormName = "song-action")]
    private string? UpSlug { get; set; }

    [SupplyParameterFromForm(FormName = "song-action")]
    private string? DownSlug { get; set; }

    [SupplyParameterFromForm(FormName = "song-action")]
    private string? RemoveSlug { get; set; }

    private ArtistDetails? artist;
    private Guid? userKey;
    private string? error;

    // True when the mixtape belongs to who is looking at it.
    private bool isOwner;

    // The artists of the catalog go back to the examples; a mixtape, to the start.
    private string BackUrl => artist!.OwnerKey is null ? PageNames.Examples : PageNames.Home;

    private string BackText => artist!.OwnerKey is null
        ? L["Examples.Title"].Value
        : isOwner ? L["Mine.Title"].Value : L["Layout.Home"].Value;

    protected override async Task OnInitializedAsync()
    {
        artist = await ArtistsService.GetArtistAsync(Slug);

        if (artist is null)
        {
            Navigation.NotFound();
            return;
        }

        userKey = HttpContext.User.GetUserKey();
        isOwner = artist.OwnerKey is not null && artist.OwnerKey == userKey;
    }

    // Id of the window with the actions of a song.
    private static string SheetId(TrackInfo track) => $"song-{track.Slug}";

    // Removes a song or moves it one place, and shows the page again.
    private async Task SongActionAsync()
    {
        if (artist is null || userKey is null)
        {
            return;
        }

        // The song that moves; empty when the button was the one to remove.
        string movedSlug = UpSlug ?? DownSlug ?? "";

        MixtapeResult result = RemoveSlug is not null
            ? await MixtapesService.RemoveTrackAsync(userKey.Value, RemoveSlug)
            : await MixtapesService.ShiftTrackAsync(userKey.Value, movedSlug, up: UpSlug is not null);

        if (result.Slug is null)
        {
            error = L[$"Mixtape.Error.{result.Status}", MixtapeLimits.MaxMixtapes, MixtapeLimits.MaxTracks].Value;
            return;
        }

        // After moving a song, the page opens where that song is.
        Navigation.NavigateTo(RemoveSlug is not null
            ? PageNames.ArtistUrl(artist.Slug)
            : PageNames.ArtistUrl(artist.Slug, movedSlug));
    }

    // Deletes the mixtape with its songs and goes back to the start.
    private async Task DeleteAsync()
    {
        if (artist is null || userKey is null)
        {
            return;
        }

        MixtapeResult result = await MixtapesService.DeleteAsync(userKey.Value, artist.Slug);

        if (result.Slug is null)
        {
            error = L[$"Mixtape.Error.{result.Status}", MixtapeLimits.MaxMixtapes, MixtapeLimits.MaxTracks].Value;
            return;
        }

        Navigation.NavigateTo(PageNames.Home);
    }
}
