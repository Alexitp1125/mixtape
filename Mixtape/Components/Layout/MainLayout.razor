@inherits LayoutComponentBase
@inject NavigationManager Navigation

@* The data-app-* buttons and the iPhone dialog are run by js/app-shell.js (dev-conventions/pwa). *@
<header class="mx-bar">
    <div class="mx-bar-inner">
        @if (!IsHome)
        {
            <button class="mx-icon-btn mx-app-only" type="button" data-app-back aria-label="@L["Layout.Back"]">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8H3m4-4L3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
        }

        <a class="mx-brand" href="/">
            <img src="brand/rako-mark.svg" alt="" width="32" height="32" />
            <span>Mixtape</span>
        </a>

        <div class="mx-bar-end">
            <button class="mx-install" type="button" data-app-install hidden>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M2.5 13.5h11" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                @L["Layout.Install"]
            </button>

            @* Full page load on purpose: WebAssembly has to restart in the new language. *@
            <nav class="mx-langs" aria-label="@L["Layout.Language"]">
                <a href="@CultureUrl("en")" lang="en" aria-current="@Current("en")" data-enhance-nav="false">EN</a>
                <a href="@CultureUrl("es")" lang="es" aria-current="@Current("es")" data-enhance-nav="false">ES</a>
            </nav>

            @* Handled by js/theme.js. *@
            <button class="mx-icon-btn" type="button" data-theme-toggle aria-label="@L["Layout.Theme"]">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                    <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <path d="M8 1.5a6.5 6.5 0 0 1 0 13Z" fill="currentColor" />
                </svg>
            </button>

            <button class="mx-icon-btn mx-app-only" type="button" data-app-share data-copied="@L["Layout.LinkCopied"]" aria-label="@L["Layout.Share"]">
                <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="3.5" r="2" /><circle cx="4" cy="8" r="2" /><circle cx="12" cy="12.5" r="2" /><path d="M5.8 7l4.4-2.5M5.8 9l4.4 2.5" /></svg>
            </button>

            <button class="mx-icon-btn mx-app-only" type="button" data-app-reload aria-label="@L["Layout.Reload"]">
                <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9" /><path d="M13.5 2.5v3h-3" /></svg>
            </button>

            <a class="mx-platform" href="https://alexitp1125.com" target="_blank" rel="noopener">alexitp1125 ↗</a>
        </div>
    </div>
</header>

<dialog class="mx-ios-install" data-app-ios-install aria-labelledby="mx-ios-install-title">
    <h2 id="mx-ios-install-title">@L["Install.Title"]</h2>
    <ol>
        <li>
            @L["Install.Step1"]
            <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 1.5v8.5M5 4.5l3-3 3 3M5 7H3.5v7.5h9V7H11" /></svg>
        </li>
        <li>@L["Install.Step2"]</li>
        <li>@L["Install.Step3"]</li>
    </ol>
    <button type="button" data-app-ios-close>@L["Install.Close"]</button>
</dialog>

<main class="mx-main">
    @Body

    <footer class="mx-footer">
        <a class="mx-platform" href="https://alexitp1125.com" target="_blank" rel="noopener">alexitp1125 ↗</a>
    </footer>
</main>

@* Blazor shows this bar when an interactive component fails. *@
<div id="blazor-error-ui" data-nosnippet>
    @L["Layout.Error"]
    <a href="." class="reload">@L["Layout.Reload"]</a>
    <span class="dismiss">✕</span>
</div>

@code {
    // Back only makes sense away from the song list.
    private bool IsHome => new Uri(Navigation.Uri).AbsolutePath == PageNames.Home;

    // Link that saves the language and comes back to the current page.
    private string CultureUrl(string culture)
    {
        string current = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        return $"/culture/{culture}?redirectUri={Uri.EscapeDataString(current)}";
    }

    private string? Current(string culture) =>
        CultureInfo.CurrentUICulture.Name == culture ? "true" : null;
}
