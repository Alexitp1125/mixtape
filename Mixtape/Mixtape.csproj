<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mixtape.Client\Mixtape.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
  </ItemGroup>

  <!-- Songs and covers travel with the published app. -->
  <ItemGroup>
    <Content Update="Content\tracks.json" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Content\covers\*.svg" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
