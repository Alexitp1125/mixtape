<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>mixtape-02dc97b6-1abd-47cb-b26e-e1e163d02244</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mixtape.Client\Mixtape.Client.csproj" />
    <ProjectReference Include="..\Mixtape.Application\Mixtape.Application.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <!-- For "dotnet ef": creating migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <!-- The catalog and the covers travel with the published app. -->
  <ItemGroup>
    <Content Update="Content\catalog.json" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Content\covers\*.svg" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
